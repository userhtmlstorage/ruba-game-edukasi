# GEMINI_API_KEY (server-side) & VITE_GEMINI_API_KEY (client/static build via .env.local):
# Jangan pernah menulis API key asli di file ini atau di kode sumber.
# Simpan nilai asli hanya di file .env.local (otomatis diabaikan Git).
GEMINI_API_KEY=""
VITE_GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Opsional untuk build APK offline/statis (Capacitor / WebIntoApp ZIP dari dist/):
# Isi dengan URL lengkap endpoint /api/tts server yang sudah dideploy agar suara neural tetap aktif.
# Contoh: VITE_TTS_API_URL="https://nama-app-anda.run.app/api/tts"
VITE_TTS_API_URL=""

# ==============================================================================
# KONFIGURASI GOOGLE ADMOB (AKUN ADMOB TERPISAH DARI EMAIL PENGEMBANG)
# Nilai di bawah diambil dari Dashboard Google AdMob milik email akun AdMob Anda:
# - ADMOB_APP_ID : Dashboard AdMob -> Apps -> App settings
# - AD_UNIT_ID   : Dashboard AdMob -> Apps -> Ad units
# ==============================================================================
VITE_ADMOB_TEST_MODE="true"
VITE_ADMOB_APP_ID_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY"
VITE_ADMOB_APP_ID_IOS="ca-app-pub-XXXXXXXXXXXXXXXX~ZZZZZZZZZZ"
VITE_ADMOB_BANNER_ID_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX/1111111111"
VITE_ADMOB_BANNER_ID_IOS="ca-app-pub-XXXXXXXXXXXXXXXX/2222222222"
VITE_ADMOB_INTERSTITIAL_ID_ANDROID="ca-app-pub-XXXXXXXXXXXXXXXX/3333333333"
VITE_ADMOB_INTERSTITIAL_ID_IOS="ca-app-pub-XXXXXXXXXXXXXXXX/4444444444"

